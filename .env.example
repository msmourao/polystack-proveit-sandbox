# Leave empty to use MockLLMProvider (local, no credentials).
OPENAI_API_KEY=
# Vultr Serverless Inference (OpenAI-compatible):
# OPENAI_BASE_URL=https://api.vultrinference.com/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Docker image built from ./runner
SANDBOX_IMAGE=polystack-proveit-runner:local
SANDBOX_TIMEOUT_SEC=5
SANDBOX_MEMORY=128m
SANDBOX_CPUS=0.5
